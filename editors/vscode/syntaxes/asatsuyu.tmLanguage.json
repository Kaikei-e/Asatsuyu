{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.asatsuyu",
  "name": "Asatsuyu",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#ffi-import" },
    { "include": "#import-statement" },
    { "include": "#type-definition" },
    { "include": "#function-definition" },
    { "include": "#let-binding" },
    { "include": "#storage-keywords" },
    { "include": "#storage-modifiers" },
    { "include": "#control-keywords" },
    { "include": "#other-keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#type-names" },
    { "include": "#wildcard" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.asatsuyu",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.asatsuyu",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.asatsuyu" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.asatsuyu" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.asatsuyu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.asatsuyu",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.asatsuyu",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.asatsuyu",
          "match": "\\b(True|False)\\b"
        }
      ]
    },

    "ffi-import": {
      "patterns": [
        {
          "match": "\\b(from)\\s+(python)\\s+(import)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.asatsuyu" },
            "2": { "name": "support.other.module.asatsuyu" },
            "3": { "name": "keyword.control.import.asatsuyu" },
            "4": { "name": "entity.name.namespace.asatsuyu" },
            "5": { "name": "keyword.control.as.asatsuyu" },
            "6": { "name": "entity.name.namespace.asatsuyu" }
          }
        }
      ]
    },

    "import-statement": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)(?:\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.asatsuyu" },
            "2": { "name": "entity.name.namespace.asatsuyu" },
            "3": { "name": "keyword.control.as.asatsuyu" },
            "4": { "name": "entity.name.namespace.asatsuyu" }
          }
        }
      ]
    },

    "type-definition": {
      "patterns": [
        {
          "match": "\\b(pub)\\s+(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.asatsuyu" },
            "2": { "name": "keyword.declaration.type.asatsuyu" },
            "3": { "name": "entity.name.type.asatsuyu" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.asatsuyu" },
            "2": { "name": "entity.name.type.asatsuyu" }
          }
        }
      ]
    },

    "function-definition": {
      "comment": "Only `fn <name>`. Leading pub/pure/async are left to #storage-modifiers, so every combination of them works without enumerating each one.",
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.asatsuyu" },
            "2": { "name": "entity.name.function.asatsuyu" }
          }
        }
      ]
    },

    "let-binding": {
      "patterns": [
        {
          "match": "\\b(let)\\s+(mut)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.asatsuyu" },
            "2": { "name": "storage.modifier.mutable.asatsuyu" },
            "3": { "name": "variable.other.asatsuyu" }
          }
        },
        {
          "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.asatsuyu" },
            "2": { "name": "variable.other.asatsuyu" }
          }
        }
      ]
    },

    "storage-keywords": {
      "comment": "Catch-all for fn/type/async when not part of a structured declaration (e.g., lambda fn(x) { ... })",
      "patterns": [
        {
          "name": "keyword.declaration.function.asatsuyu",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.declaration.type.asatsuyu",
          "match": "\\btype\\b"
        }
      ]
    },

    "storage-modifiers": {
      "comment": "Catch-all for pub/mut/async/pure when not captured by structured patterns",
      "patterns": [
        {
          "name": "storage.modifier.asatsuyu",
          "match": "\\bpub\\b"
        },
        {
          "name": "storage.modifier.mutable.asatsuyu",
          "match": "\\bmut\\b"
        },
        {
          "name": "storage.modifier.async.asatsuyu",
          "match": "\\basync\\b"
        },
        {
          "name": "storage.modifier.pure.asatsuyu",
          "match": "\\bpure\\b"
        }
      ]
    },

    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.asatsuyu",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.await.asatsuyu",
          "match": "\\bawait\\b"
        },
        {
          "name": "keyword.control.trycatch.asatsuyu",
          "match": "\\btry\\b"
        }
      ]
    },

    "other-keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.asatsuyu",
          "match": "\\b(from|import)\\b"
        },
        {
          "name": "keyword.control.as.asatsuyu",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.declaration.variable.asatsuyu",
          "match": "\\blet\\b"
        },
        {
          "name": "support.other.module.asatsuyu",
          "match": "\\bpython\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.asatsuyu",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.string-concat.asatsuyu",
          "match": "<>"
        },
        {
          "name": "keyword.operator.logical.asatsuyu",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.comparison.asatsuyu",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arrow.asatsuyu",
          "match": "->"
        },
        {
          "name": "keyword.operator.spread.asatsuyu",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.asatsuyu",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.asatsuyu",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.asatsuyu",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.logical.asatsuyu",
          "match": "!"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.asatsuyu",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.asatsuyu",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.asatsuyu",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.asatsuyu",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.asatsuyu",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.asatsuyu",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.asatsuyu",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.asatsuyu",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.asatsuyu",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.dot.asatsuyu",
          "match": "\\."
        }
      ]
    },

    "type-names": {
      "comment": "Uppercase-initial identifiers — ADT constructors and type names",
      "patterns": [
        {
          "name": "entity.name.type.asatsuyu",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "wildcard": {
      "patterns": [
        {
          "name": "variable.language.wildcard.asatsuyu",
          "match": "\\b_\\b"
        }
      ]
    }
  }
}
