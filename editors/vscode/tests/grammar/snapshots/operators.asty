fn pipeline_demo(xs: List(Int)) -> List(Int) {
  xs
  |> list.filter(fn(x) { x > 0 })
  |> list.map(fn(x) { x * 2 })
}

fn string_ops(a: String, b: String) -> String {
  a <> " " <> b
}

fn logic(a: Bool, b: Bool) -> Bool {
  a && b || !a
}

fn compare(x: Int, y: Int) -> Bool {
  x == y || x != y || x <= y || x >= y
}

fn arithmetic(a: Int, b: Int) -> Int {
  a + b - a * b / a % b
}
