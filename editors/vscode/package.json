{
  "name": "asatsuyu",
  "displayName": "Asatsuyu",
  "description": "Language support for the Asatsuyu programming language",
  "version": "0.1.0",
  "publisher": "asatsuyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaikei/asatsuyu"
  },
  "bugs": {
    "url": "https://github.com/kaikei/asatsuyu/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:asatsuyu"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "asatsuyu",
        "aliases": [
          "Asatsuyu",
          "asatsuyu"
        ],
        "extensions": [
          ".asty"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asatsuyu",
        "scopeName": "source.asatsuyu",
        "path": "./syntaxes/asatsuyu.tmLanguage.json"
      },
      {
        "scopeName": "markdown.asatsuyu.codeblock",
        "path": "./syntaxes/asatsuyu.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.asatsuyu": "asatsuyu"
        }
      }
    ],
    "snippets": [
      {
        "language": "asatsuyu",
        "path": "./snippets/asatsuyu.code-snippets"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "ffi",
        "description": "Symbol imported from Python via FFI"
      },
      {
        "id": "checked",
        "description": "Checked FFI — runtime validation applied"
      },
      {
        "id": "verified",
        "description": "Verified FFI — fully typed, sound boundary"
      }
    ],
    "configuration": {
      "title": "Asatsuyu",
      "properties": {
        "asatsuyu.serverPath": {
          "type": "string",
          "default": "asatsuyu",
          "description": "Path to the Asatsuyu language server executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "typescript": "^6.0.0"
  }
}
