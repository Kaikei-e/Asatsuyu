{
  "name": "asatsuyu",
  "displayName": "Asatsuyu",
  "description": "Language support for the Asatsuyu programming language",
  "version": "0.1.0",
  "publisher": "asatsuyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaikei/asatsuyu"
  },
  "bugs": {
    "url": "https://github.com/kaikei/asatsuyu/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "activationEvents": [
    "onLanguage:asatsuyu",
    "onCommand:asatsuyu.openStarter",
    "onCommand:asatsuyu.openSyntaxGuide"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "asatsuyu",
        "aliases": [
          "Asatsuyu",
          "asatsuyu"
        ],
        "extensions": [
          ".asty"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asatsuyu",
        "scopeName": "source.asatsuyu",
        "path": "./syntaxes/asatsuyu.tmLanguage.json"
      },
      {
        "scopeName": "markdown.asatsuyu.codeblock",
        "path": "./syntaxes/asatsuyu.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.asatsuyu": "asatsuyu"
        }
      }
    ],
    "snippets": [
      {
        "language": "asatsuyu",
        "path": "./snippets/asatsuyu.code-snippets"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "ffi",
        "description": "Symbol imported from Python via FFI"
      },
      {
        "id": "checked",
        "description": "Checked FFI — runtime validation applied"
      },
      {
        "id": "verified",
        "description": "Verified FFI — fully typed, sound boundary"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "asatsuyu",
        "scopes": {
          "namespace": [
            "entity.name.namespace.asatsuyu"
          ],
          "type": [
            "entity.name.type.asatsuyu"
          ],
          "enumMember": [
            "variable.other.enummember.asatsuyu"
          ],
          "typeParameter": [
            "entity.name.type.parameter.asatsuyu"
          ],
          "parameter": [
            "variable.parameter.asatsuyu"
          ],
          "variable": [
            "variable.other.asatsuyu"
          ],
          "variable.readonly": [
            "variable.other.constant.asatsuyu"
          ],
          "variable.modification": [
            "variable.other.readwrite.asatsuyu"
          ],
          "property": [
            "variable.other.property.asatsuyu"
          ],
          "function": [
            "entity.name.function.asatsuyu"
          ],
          "function.async": [
            "entity.name.function.async.asatsuyu"
          ],
          "*.declaration": [
            "entity.name.asatsuyu"
          ],
          "*.defaultLibrary": [
            "support.function.builtin.asatsuyu"
          ],
          "*.ffi": [
            "support.other.module.asatsuyu"
          ],
          "*.checked": [
            "support.other.module.checked.asatsuyu"
          ],
          "*.verified": [
            "support.other.module.verified.asatsuyu"
          ]
        }
      }
    ],
    "themes": [
      {
        "label": "Asatsuyu Dawn (Reference)",
        "uiTheme": "vs",
        "path": "./themes/asatsuyu-dawn-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "asatsuyu.openStarter",
        "title": "Asatsuyu: Open Starter File"
      },
      {
        "command": "asatsuyu.openSyntaxGuide",
        "title": "Asatsuyu: Open Syntax Guide"
      }
    ],
    "walkthroughs": [
      {
        "id": "asatsuyu.getStarted",
        "title": "Get Started with Asatsuyu",
        "description": "Learn the core features of Asatsuyu — a statically typed language for the Python ecosystem.",
        "steps": [
          {
            "id": "asatsuyu.openStarter",
            "title": "Open a Starter File",
            "description": "Create your first `.asty` file and explore the language.\n\n[Open Starter File](command:asatsuyu.openStarter)",
            "media": {
              "markdown": "media/walkthrough/step-functions.md"
            },
            "completionEvents": [
              "onLanguage:asatsuyu"
            ]
          },
          {
            "id": "asatsuyu.learnTypes",
            "title": "Define Types and Match",
            "description": "Model your domain with algebraic data types. The compiler ensures exhaustive pattern matching.",
            "media": {
              "markdown": "media/walkthrough/step-types.md"
            }
          },
          {
            "id": "asatsuyu.learnMut",
            "title": "Mutability and Assignment",
            "description": "Bindings are immutable by default. Use `let mut` to opt in — the editor highlights reassignment sites.",
            "media": {
              "markdown": "media/walkthrough/step-mutability.md"
            }
          },
          {
            "id": "asatsuyu.learnPipelines",
            "title": "Transform Data with Pipelines",
            "description": "Chain transformations with `|>` for left-to-right data flow.",
            "media": {
              "markdown": "media/walkthrough/step-pipelines.md"
            }
          },
          {
            "id": "asatsuyu.learnFFI",
            "title": "Use Python Libraries",
            "description": "Import Python modules with `from python import`. Use `try` to safely convert exceptions to `Result`.",
            "media": {
              "markdown": "media/walkthrough/step-ffi.md"
            }
          },
          {
            "id": "asatsuyu.nextSteps",
            "title": "Next Steps",
            "description": "Explore more examples, open the syntax guide, and build your first program.\n\n[Open Syntax Guide](command:asatsuyu.openSyntaxGuide)",
            "media": {
              "markdown": "media/walkthrough/step-next.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Asatsuyu",
      "properties": {
        "asatsuyu.serverPath": {
          "type": "string",
          "default": "asatsuyu",
          "description": "Path to the Asatsuyu language server executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:grammar": "vscode-tmgrammar-snap -s source.asatsuyu -g syntaxes/asatsuyu.tmLanguage.json 'tests/grammar/snapshots/*.asty'",
    "test:snippets": "node tests/snippet-check.mjs",
    "test": "pnpm run test:grammar && pnpm run test:snippets"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
