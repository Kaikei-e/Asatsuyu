{
  "name": "asatsuyu",
  "displayName": "Asatsuyu",
  "description": "Language support for the Asatsuyu programming language",
  "version": "0.1.0",
  "publisher": "asatsuyu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:asatsuyu"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "asatsuyu",
        "aliases": [
          "Asatsuyu",
          "asatsuyu"
        ],
        "extensions": [
          ".asty"
        ],
        "configuration": "./language-configuration.json",
        "scopeName": "source.asatsuyu"
      }
    ],
    "grammars": [
      {
        "language": "asatsuyu",
        "scopeName": "source.asatsuyu",
        "path": "./syntaxes/asatsuyu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Asatsuyu",
      "properties": {
        "asatsuyu.serverPath": {
          "type": "string",
          "default": "asatsuyu",
          "description": "Path to the Asatsuyu language server executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "typescript": "^6.0.0"
  }
}
