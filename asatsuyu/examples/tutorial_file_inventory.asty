// ============================================================================
// Asatsuyu チュートリアル: 拡張子分析パイプライン
// ============================================================================
//
// このプログラムは Asatsuyu の全 14 予約語を実践的に使い、
// リスト操作パイプラインで実際にデータを変換・集計する例です。
//
// 使用キーワード:
//   fn, pub, let, type, match, if, else,
//   import, from, python, as, True, False, try
//
// 使用言語機能:
//   ADT, パターンマッチ, パイプライン |>, list.map, list.filter,
//   文字列結合 <>, Python FFI (pathlib/os/sys), try 式

// ── Python FFI ────────────────────────────────────────────────
// Verified FFI: 型情報が完全な Python 標準ライブラリ

from python import pathlib
from python import os
from python import sys

// ── モジュールエイリアス ──────────────────────────────────────

import io as output

// ── 基盤 ADT ─────────────────────────────────────────────────

pub type Option(a) {
  Some(a)
  None
}

pub type Result(a, e) {
  Ok(a)
  Error(e)
}

pub type PyException {
  PyExc(
    kind: String,
    exception_type: String,
    message: String,
    module: String,
    traceback_summary: String
  )
}

// ── ドメイン型 ───────────────────────────────────────────────
// ファイルの種類を ADT で分類する。
// 各バリアントが異なる付加情報を持つ。

pub type FileCategory {
  Source(language: String)
  Document(format: String)
  Data(format: String)
  Image(format: String)
  Config(name: String)
  Unknown(extension: String)
}

// 分析結果もADTで。成功と失敗を型で区別する。

pub type AnalysisResult {
  AnalysisOk(summary: String)
  AnalysisFailed(reason: String)
}

// ============================================================================
// 分類ロジック
// ============================================================================

// 拡張子からカテゴリを判定する。
// match の網羅性はコンパイラが保証する。

pub fn categorize(ext: String) -> FileCategory {
  match ext {
    ".py" -> Source("Python")
    ".rs" -> Source("Rust")
    ".ts" -> Source("TypeScript")
    ".js" -> Source("JavaScript")
    ".go" -> Source("Go")
    ".asty" -> Source("Asatsuyu")
    ".md" -> Document("Markdown")
    ".txt" -> Document("Text")
    ".html" -> Document("HTML")
    ".json" -> Data("JSON")
    ".csv" -> Data("CSV")
    ".toml" -> Data("TOML")
    ".yaml" -> Data("YAML")
    ".png" -> Image("PNG")
    ".jpg" -> Image("JPEG")
    ".svg" -> Image("SVG")
    ".gitignore" -> Config("git")
    ".editorconfig" -> Config("editor")
    _ -> Unknown(ext)
  }
}

// バリアント分解でカテゴリ名を取得。

pub fn category_label(cat: FileCategory) -> String {
  match cat {
    Source(lang) -> "Source (" <> lang <> ")"
    Document(fmt) -> "Document (" <> fmt <> ")"
    Data(fmt) -> "Data (" <> fmt <> ")"
    Image(fmt) -> "Image (" <> fmt <> ")"
    Config(name) -> "Config (" <> name <> ")"
    Unknown(ext) -> "Unknown (" <> ext <> ")"
  }
}

// 短い識別タグ。

pub fn category_tag(cat: FileCategory) -> String {
  match cat {
    Source(_) -> "src"
    Document(_) -> "doc"
    Data(_) -> "dat"
    Image(_) -> "img"
    Config(_) -> "cfg"
    Unknown(_) -> "???"
  }
}

// ============================================================================
// 述語関数: True / False
// ============================================================================

pub fn is_source(cat: FileCategory) -> Bool {
  match cat {
    Source(_) -> True
    _ -> False
  }
}

pub fn is_known(cat: FileCategory) -> Bool {
  match cat {
    Unknown(_) -> False
    _ -> True
  }
}

// ============================================================================
// サイズ分類: if / else チェーン
// ============================================================================

pub fn classify_size(bytes: Int) -> String {
  if bytes > 1073741824 {
    "large (> 1 GB)"
  } else if bytes > 1048576 {
    "medium (1 MB - 1 GB)"
  } else if bytes > 1024 {
    "small (1 KB - 1 MB)"
  } else {
    "tiny (< 1 KB)"
  }
}

// ============================================================================
// Option / Result ヘルパー
// ============================================================================

pub fn unwrap_or(opt: Option, default: String) -> String {
  match opt {
    Some(value) -> value
    None -> default
  }
}

pub fn unwrap_string_result(r: Result, default: String) -> String {
  match r {
    Ok(value) -> value
    Error(_) -> default
  }
}

pub fn unwrap_bool_result(r: Result) -> Bool {
  match r {
    Ok(value) -> value
    Error(_) -> False
  }
}

pub fn is_ok(result: Result) -> Bool {
  match result {
    Ok(_) -> True
    Error(_) -> False
  }
}

// ============================================================================
// Python FFI: ファイルシステム操作
// ============================================================================
// `try` で Python 例外を Result に安全に変換する。
// Asatsuyu の純粋領域には例外が入らない。

pub fn check_directory(path: String) -> Result(Bool, PyException) {
  let p = pathlib.Path(path)
  let exists = try p.exists()
  Ok(exists)
}

pub fn safe_getcwd() -> Result(String, PyException) {
  let cwd = try os.getcwd()
  Ok(cwd)
}

pub fn get_platform() -> String {
  sys.platform
}

// ============================================================================
// パイプライン + リスト操作（本プログラムの核心）
// ============================================================================
// list.map / list.filter はコンパイラ組み込みモジュール。
// Python の list comprehension に変換される。

// 拡張子リストを受け取り、各拡張子を分類する。
// list.map で一括変換 → Python では [categorize(x) for x in exts] になる。

pub fn categorize_all(exts: List(String)) -> List(FileCategory) {
  exts |> list.map(fn(ext) { categorize(ext) })
}

// ソースコードだけを抽出する。
// list.filter で条件フィルタ → Python では [x for x in cats if is_source(x)] になる。

pub fn source_files_only(cats: List(FileCategory)) -> List(FileCategory) {
  cats |> list.filter(fn(cat) { is_source(cat) })
}

// 既知のカテゴリだけを抽出する。

pub fn known_files_only(cats: List(FileCategory)) -> List(FileCategory) {
  cats |> list.filter(fn(cat) { is_known(cat) })
}

// カテゴリリストからタグ一覧を生成する。

pub fn extract_tags(cats: List(FileCategory)) -> List(String) {
  cats |> list.map(fn(cat) { category_tag(cat) })
}

// カテゴリリストからラベル一覧を生成する。

pub fn extract_labels(cats: List(FileCategory)) -> List(String) {
  cats |> list.map(fn(cat) { category_label(cat) })
}

// AnalysisResult を文字列に変換する。

pub fn result_message(ar: AnalysisResult) -> String {
  match ar {
    AnalysisOk(summary) -> "OK: " <> summary
    AnalysisFailed(reason) -> "FAILED: " <> reason
  }
}

// ============================================================================
// メイン: 全機能を組み合わせた分析パイプライン
// ============================================================================

pub fn main() {
  // ── 1. Python FFI でシステム情報を取得 ──
  let platform = get_platform()
  let cwd_result = safe_getcwd()
  let directory = unwrap_string_result(cwd_result, "(unknown)")
  let dir_check = check_directory(directory)
  let dir_exists = unwrap_bool_result(dir_check)

  let status = if dir_exists {
    AnalysisOk(directory <> " on " <> platform)
  } else {
    AnalysisFailed("directory not found")
  }

  // ── 2. 拡張子リストをパイプラインで分析 ──
  // これが Asatsuyu の真価: リスト操作 + パイプライン + ADT
  let extensions = [".py", ".rs", ".toml", ".md", ".png", ".xyz", ".json", ".ts", ".gitignore"]

  // 全拡張子を分類
  let all_categories = extensions |> list.map(fn(ext) { categorize(ext) })

  // ソースコードだけをフィルタ
  let sources = all_categories |> list.filter(fn(cat) { is_source(cat) })

  // 既知ファイルだけをフィルタ
  let known = all_categories |> list.filter(fn(cat) { is_known(cat) })

  // タグ一覧を生成（パイプラインの連鎖）
  let all_tags = all_categories |> list.map(fn(cat) { category_tag(cat) })
  let source_labels = sources |> list.map(fn(cat) { category_label(cat) })

  // 件数を集計
  let total_count = list.length(all_categories)
  let source_count = list.length(sources)
  let known_count = list.length(known)

  // サイズ分類の例
  let sizes = [128, 2048, 5000000, 2000000000]
  let size_labels = sizes |> list.map(fn(bytes) { classify_size(bytes) })

  // ── 3. レポート出力 ──
  println("=== Asatsuyu File Category Analyzer ===")
  println("Status: " <> result_message(status))
  println("")

  println("Input extensions:")
  println(extensions)

  println("")
  println("All categories (tags):")
  println(all_tags)

  println("")
  println("Source files only:")
  println(source_labels)

  println("")
  println("Size classifications:")
  println(size_labels)

  println("")
  println("Summary:")
  println("  Total files:  " <> classify_size(total_count))
  println("  Source files:  " <> classify_size(source_count))
  println("  Known files:  " <> classify_size(known_count))

  // ── 4. パイプライン1行で変換の連鎖を示す ──
  println("")
  println("One-liner pipeline demo:")
  [".py", ".rs", ".md", ".json", ".xyz"]
  |> list.map(fn(ext) { categorize(ext) })
  |> list.filter(fn(cat) { is_source(cat) })
  |> list.map(fn(cat) { category_label(cat) })
  |> println
}
